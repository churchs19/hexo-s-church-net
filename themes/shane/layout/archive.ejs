<%- partial('_partial/nav') %>
<main id="main" tabindex="-1" class="container page-container with-sidebar">
  <div class="page-content">
<%
    var title = page.title;

    if (is_archive()){
      title = 'Blog';

      if (is_month()){
        title += ': ' + moment(page.month + '-1-' + page.year, "MM-DD-YYYY").format('MMMM YYYY');
      } else if (is_year()){
        title += ': ' + page.year;
      }
    } else if (is_category()){
      title = 'Category: ' + page.category;
    } else if (is_tag()){
      title = 'Tag: ' + page.tag;
    }
%>
    <h2 class="section-title reveal"><% if (title){ %><%= title %><% } else { %><%= config.title %><% } %></h2>
    <%- partial('_partial/archive', {pagination: config.archive, index: true}) %>
  </div>
  <aside class="blog-sidebar">
    <%- partial('_partial/sidebar', null, {cache: !config.relative_link}) %>
  </aside>
</main>