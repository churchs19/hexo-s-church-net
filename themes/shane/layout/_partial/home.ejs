<!-- Home Section -->
<section
  id="home"
  class="intro-container hero-full"
  data-parallax
>
  <div class="intro">
    <h1><%= config.title %></h1>
    <div class="intro-sub"><%= config.subtitle %></div>
    <p><%= config.description %></p>

    <div class="social-icons">
      <ul class="social-list">
        <li>
          <a
            href="https://www.instagram.com/churchs19/"
            target="_blank"
            title="Instagram"
            aria-label="Instagram"
            ><i class="fa-brands fa-instagram" aria-hidden="true"></i
          ></a>
        </li>
        <li>
          <a href="https://github.com/churchs19" target="_blank" title="GitHub"
            aria-label="GitHub"
            ><i class="fa-brands fa-github" aria-hidden="true"></i
          ></a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/shanechurch"
            target="_blank"
            title="LinkedIn"
            aria-label="LinkedIn"
            ><i class="fa-brands fa-linkedin" aria-hidden="true"></i
          ></a>
        </li>
        <li>
          <a
            href="https://bsky.app/profile/s-church.net"
            target="_blank"
            title="BlueSky"
            aria-label="BlueSky"
            ><i class="fa-brands fa-bluesky" aria-hidden="true"></i
          ></a>
        </li>
        <li>
          <a
            href="https://www.facebook.com/shanechurch62"
            target="_blank"
            title="Facebook"
            aria-label="Facebook"
            ><i class="fa-brands fa-facebook" aria-hidden="true"></i
          ></a>
        </li>
      </ul>
    </div>
    <!-- /.social-icons -->
  </div>

  <div class="mouse-icon" aria-hidden="true">
    <div class="wheel"></div>
  </div>
</section>
<!-- End Home Section -->
