<% if (is_post()) { %>
    <script type="application/ld+json">
		{
			"@context": "http://schema.org",
			"@type": "BlogPosting",
            <% if (post.title) { %>
            "headline": "<%= post.title %> | <%= config.title %>",
            <% } else { %>
 			"headline": "<%= config.title %>",
            <% } %>
			<% if (post.description){ %>
			"description": "<%= post.description %>",
			<% } else if (post.excerpt){ %>
			"description": "<%= post.excerpt %>",
			<% } %>
			"mainEntityOfPage":{
			    "@type":"WebPage",
			    "@id":"<%= config.url %>/<%= post.path %>"
			},
			"datePublished": "<%= post.date.toISOString() %>",
			"dateModified": "<%= post.updated.toISOString() %>",
			<% if (post.eyeCatchImage && post.eyeCatchImage != "" && post.eyeCatchImageProperty && post.eyeCatchImageProperty.width && post.eyeCatchImageProperty.height){ %>
			"image": {
				"@type": "ImageObject",
				"url": "<%= post.eyeCatchImage %>",
				"width" : <%= post.eyeCatchImageProperty.width %>,
				"height" : <%= post.eyeCatchImageProperty.height %>
			},
			<% } %>
			"author": {
			    "@type": "Person",
			    "name": "<%= config.author %>"
			},
			"publisher": {
			    "@type": "Organization",
			    "name": "<%= config.title %>"
			    <% if (config.site_logo){ %>
			    ,
			    "logo": "<%= config.url %>/<%= config.site_logo %>"
			    <% } %>
			}
		}
	</script>
<% } else { %>
<%
var person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": config.author,
  "url": config.url,
  "jobTitle": config.subtitle,
  "description": config.description
};
if (config.site_logo) person.image = config.url + '/' + config.site_logo;
if (config.email) person.email = 'mailto:' + config.email;
if (config.social) person.sameAs = config.social;
%>
<script type="application/ld+json"><%- JSON.stringify(person, null, 2).replace(/</g, '\\u003c') %></script>
<% } %>
