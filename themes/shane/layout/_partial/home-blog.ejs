<!-- Blog Section -->
<section id="blog" class="latest-blog-section section-padding">
  <div class="container">
    <h2 class="section-title reveal">Blog</h2>
    <% if (site.posts.length){ %>
    <div class="post-grid">
      <% site.posts.sort('date', -1).limit(3).each(function(post){ %>
      <%- partial('_partial/archive-post', {post: post, index: true}) %>
      <% }) %>
    </div>
    <% } %>
    <div class="blog-more">
      <a href="<%- url_for(config.archive_dir + '/') %>" class="btn btn-primary">View More</a>
    </div>
  </div>
</section>
<!-- End Blog Section -->
