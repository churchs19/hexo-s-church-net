<% if (post.photos && post.photos.length){ %>
<div class="article-gallery">
  <% post.photos.forEach(function(photo, i){ %>
  <a class="image-link" href="<%- url_for(photo.split('|')[0]) %>" title="<%- photo.split('|')[1] %>">
    <img src="<%- url_for(photo.split('|')[0]) %>" loading="lazy" decoding="async" itemprop="image" alt="<%- photo.split('|')[1] %>" />
  </a>
  <% }) %>
</div>
<% } %>
