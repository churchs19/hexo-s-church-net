<article class="blog-post-wrapper archive-type-<%= post.layout %>">
  <div class="figure">
    <%
    var thumbnail = '/images/blog/default-post.jpg';
    if (post.featured_image) {
      thumbnail = thumbnail_url(post.featured_image);
    } else if (post.photos && post.photos.length >= 1) {
      thumbnail = thumbnail_url(url_for(post.photos[0].split('|')[0]));
    }
    %>
    <div class="post-thumbnail">
      <a href="<%- url_for(post.path) %>" tabindex="-1" aria-hidden="true"
        ><img
          src="<%- thumbnail %>"
          alt=""
          loading="lazy"
          decoding="async"
      /></a>
    </div>
    <span><img src="/images/SCLogo-Transparent.svg" alt="" /></span>
  </div>
  <!-- /.figure -->
  <header class="entry-header">
    <div class="post-meta">
      <span class="the-category"> <%- partial('post/tag') %> </span>
    </div>
    <a href="<%- url_for(post.path) %>"
      ><h3 class="entry-title"><%= post.title || '(no title)' %></h3></a
    >
    <p><%- truncate(strip_html(post.content),{length: 100}) %></p>
    <div class="entry-meta">
      <ul class="meta-list">
        <li>
          <span class="the-time">
            <%- partial('post/date', {class_name: 'article-date', date_format:
            config.date_format}) %>
          </span>
        </li>
        <li>
          <span class="the-share">
            <button
              type="button"
              data-url="<%- post.permalink %>"
              data-title="<%= post.title %>"
              aria-expanded="false"
              data-id="<%= post._id %>"
              class="article-share-link"
            >
              <i class="fa-solid fa-share-from-square" aria-hidden="true"></i> Share
            </button>
          </span>
        </li>
        <li>
          <span class="the-comments">
            <a
              href="<%- config.url + url_for(post.path) %>#disqus_thread"
              title=""
            ></a>
          </span>
        </li>
      </ul>
    </div>
    <!-- .entry-meta -->
  </header>
  <!-- .entry-header -->
</article>
