<!-- Photos Section -->
<section id="photos" class="photos-section section-padding">
  <div class="container">
    <h2 class="section-title reveal">Photos</h2>
  </div>
  <% if (site.data.instagram) { %>
  <div class="photo-grid">
        <% for (var i=0; i < site.data.instagram.length; i++) { var item =
        site.data.instagram[i]; %>
        <figure class="photo-item">
          <% if (item.thumbnail_url) { %>
          <img src="<%= item.thumbnail_url %>" alt="" loading="lazy" decoding="async" />
          <% } else { %>
          <img src="<%= item.media_url %>" alt="" loading="lazy" decoding="async" />
          <% } %>
          <figcaption>
            <div class="caption-content">
              <a
                href="<%= item.permalink %>"
                class="single_image"
                target="_blank"
              >
                <% if (item.media_type === "VIDEO") { %>
                <i class="fa-solid fa-video" aria-hidden="true"></i>
                <% } else { %>
                <i class="fa-solid fa-image" aria-hidden="true"></i>
                <% } %>
                <p><%= item.caption %></p>
                <p><%= date(item.timestamp, "lll") %></p></a
              >
            </div>
          </figcaption>
        </figure>
        <% } %>
  </div>
  <% } %>
  <div class="photos-links">
    <a
      class="btn btn-primary btn-lg"
      href="https://www.instagram.com/churchs19/"
      target="_blank"
      ><i class="fa-brands fa-instagram" aria-hidden="true"></i>View More on Instagram</a
    >
  </div>
</section>
<!-- End Photos Section -->
