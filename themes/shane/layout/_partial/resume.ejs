<!-- Resume Section -->
<%
var visibleRoles = 3;
var renderPosition = function (item, idx) {
  var html = (idx % 2 === 0) ? '<li class="timeline">' : '<li class="timeline-inverted">';
  html += '<div class="posted-date"><span class="month">' + escape_html(item.start) +
    '<br/>&mdash;<br/>' + escape_html(item.end) + '</span></div>';
  html += '<div class="timeline-panel wow fadeInUp"><div class="timeline-content">';
  html += '<div class="timeline-heading"><h3>' + escape_html(item.title) + '</h3>';
  html += '<span>' + escape_html(item.company) + ' - ' + escape_html(item.location) + '</span></div>';
  html += '<div class="timeline-body"><ul>';
  (item.details || []).forEach(function (detail) {
    html += '<li>' + escape_html(detail) + '</li>';
  });
  html += '</ul></div></div></div></li>';
  return html;
};
%>
<section id="resume" class="resume-section section-padding">
  <div class="container">
    <h2 class="section-title wow fadeInUp">Resume</h2>
    <% for (category in site.data.resume) { %>
    <% var positions = site.data.resume[category]; %>
    <div class="row">
      <div class="col-md-12">
        <div class="resume-title">
          <h3><%= category %></h3>
        </div>
        <div class="resume">
          <ul class="timeline">
            <% positions.slice(0, visibleRoles).forEach(function (item, i) { %>
            <%- renderPosition(item, i + 1) %>
            <% }) %>
          </ul>
          <% if (positions.length > visibleRoles) { %>
          <details class="resume-more">
            <summary>Earlier <%= category.toLowerCase() %> (<%= positions.length - visibleRoles %> more)</summary>
            <ul class="timeline">
              <% positions.slice(visibleRoles).forEach(function (item, i) { %>
              <%- renderPosition(item, visibleRoles + i + 1) %>
              <% }) %>
            </ul>
          </details>
          <% } %>
        </div>
      </div>
    </div>
    <!-- /row -->
    <% } %>
    <div class="row">
        <div class="col-md-4 col-md-offset-4 download-button">
            <a class="btn btn-primary btn-lg btn-block" data-event-category="Download" data-event-action="resume" href="/resume.pdf" target="_blank"><i class="fa-solid fa-download" aria-hidden="true"></i>Download my resume</a>
        </div>
    </div>
  </div>
  <!-- /.container -->
</section>
<!-- End Resume Section -->
